# ─────────────────────────────────────────────────────────────────────────────
# Byup Fresh — Backend env template
#
# Copia questo file in `.env` (`cp .env.example .env`) e riempi i valori.
# Il `.env` reale è gitignorato: NON committarlo mai.
# Fonte di verità delle variabili: src/config/configuration.ts (schema Joi).
#
# [OBBLIGATORIA] = nessun default, l'app non parte se manca.
# [default: X]   = opzionale, se omessa vale X.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development          # development | production | test   [default: development]
PORT=3000                     # [default: 3000]
API_PREFIX=api/v1             # prefisso globale delle rotte       [default: api/v1]

# Database (PostgreSQL) — i valori sotto combaciano con docker-compose.yml per il dev locale
DB_HOST=localhost             # [OBBLIGATORIA]
DB_PORT=5432                  # [default: 5432]
DB_USER=byup                  # [OBBLIGATORIA]
DB_PASSWORD=byup_dev_secret   # [OBBLIGATORIA] — dev locale; in produzione usa un secret reale (Secrets Manager)
DB_NAME=byup_fresh            # [OBBLIGATORIA]
DB_SYNC=true                  # true=schema auto-sync (solo dev). In prod DEVE essere false + migrazioni. [default: false]

# JWT — i secret DEVONO essere stringhe di almeno 32 caratteri. NON usare questi placeholder in produzione.
JWT_ACCESS_SECRET=change_me_in_production_access_secret_min_32_chars   # [OBBLIGATORIA, min 32 char]
JWT_ACCESS_EXPIRES_IN=15m     # durata access token                 [default: 15m]
JWT_2FA_SECRET=change_me_in_production_2fa_secret_min_32_chars         # [OBBLIGATORIA, min 32 char]
JWT_2FA_EXPIRES_IN=5m         # durata 2FA pending token             [default: 5m]

# Refresh token (opaco, salvato hashato in DB)
REFRESH_TOKEN_TTL_DAYS=30     # [default: 30]

# TOTP issuer (nome mostrato nelle app authenticator)
TOTP_ISSUER=Byup Fresh        # [default: Byup Fresh]
